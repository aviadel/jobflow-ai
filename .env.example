# ── Required ────────────────────────────────────────────────────────────────────
# Anthropic API key — get yours at console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# JobFlow license key — the key from your purchase email.
# REQUIRED. JobFlow is paid-only; nothing works without a valid key.
JOBFLOW_LICENSE_KEY=

# Password to protect your private JobFlow instance
# Your browser will show a native password dialog on first visit
APP_PASSWORD=choose-something-strong

# Random secret unique to YOUR instance. Protects the internal endpoint the app
# uses to check your license key, so nobody else can trigger license activations
# against your instance.
# Generate one with:  openssl rand -hex 32
INTERNAL_SECRET=generate-your-own-random-string

# ── Storage ──────────────────────────────────────────────────────────────────────
# postgres — RECOMMENDED. Permanent storage. In Vercel: Storage → Create Database
#            → Postgres (free tier). POSTGRES_URL is then set for you automatically.
# sheets   — Permanent. Requires the GOOGLE_* vars below.
# json     — Default, but TEMPORARY. Writes to /tmp, which Vercel wipes whenever the
#            server restarts (after ~15 min idle). Your applications, CVs and tracker
#            history WILL be lost. Only use this to try the app out.
DATA_PROVIDER=postgres

# ── Postgres (DATA_PROVIDER=postgres) ────────────────────────────────────────────
# Set automatically when you add a Postgres database in the Vercel dashboard.
# Works with any Postgres provider (Vercel, Neon, Supabase, Railway) if set manually.
# POSTGRES_URL=

# ── Google Sheets (DATA_PROVIDER=sheets) ─────────────────────────────────────────
# The spreadsheet ID from its URL: .../spreadsheets/d/<ID>/edit
# GOOGLE_SHEETS_SPREADSHEET_ID=
# Full service account key JSON as a single-line string (paste the contents of the .json file)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}

# ── Optional ─────────────────────────────────────────────────────────────────────
# Cloudflare Web Analytics beacon token. Safe to expose — it is a public token.
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
