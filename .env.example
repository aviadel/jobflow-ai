# ── Required ────────────────────────────────────────────────────────────────────
# Anthropic API key — get yours at console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# JobFlow license key — the JWT from your purchase email
# Leave blank to use the 7-day free trial. Set after purchasing to unlock permanently.
JOBFLOW_LICENSE_KEY=

# Password to protect your private JobFlow instance
# Your browser will show a native password dialog on first visit
APP_PASSWORD=choose-something-strong

# HMAC-SHA256 secret used to verify license JWTs
# Set by the developer (not by the buyer); must match the key used to generate licenses
LICENSE_SIGNING_SECRET=change-this-to-a-long-random-string

# ── Storage ──────────────────────────────────────────────────────────────────────
# json     — default; writes to /tmp (ephemeral on Vercel, cleared on deploy)
# sheets   — persistent; requires GOOGLE_* vars below
# supabase — persistent; requires SUPABASE_* vars below (post-v1)
DATA_PROVIDER=json

# ── Google Sheets (DATA_PROVIDER=sheets) ─────────────────────────────────────────
# The spreadsheet ID from its URL: .../spreadsheets/d/<ID>/edit
# GOOGLE_SHEETS_SPREADSHEET_ID=
# Full service account key JSON as a single-line string (paste the contents of the .json file)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}

# ── Supabase (DATA_PROVIDER=supabase) ────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
